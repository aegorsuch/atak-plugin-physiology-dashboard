<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    tools:ignore="UselessParent"
    android:background="@color/greenbg"
    style="@style/AppTheme">

    <ImageView
        android:id="@+id/alertIcon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/danger"
        tools:ignore="ContentDescription"
        android:layout_gravity="center_vertical"
        android:visibility="invisible"/>

    <LinearLayout
        android:id="@+id/nameAndAlerts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/textCallsign"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="Callsign"
            android:textColor="@color/white"
            tools:ignore="RtlHardcoded"/>

        <TextView
            android:id="@+id/textisFalsePositive"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:text="Band not worn properly, readings may be incorrect"
            android:textColor="@color/light_gray"
            tools:ignore="RtlHardcoded"
            android:paddingBottom="3dp"
            android:drawableStart="@drawable/isfalsepositive"
            android:visibility = "visible"/>

        <TextView
            android:id="@+id/textLastConnected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="Last connected X minutes ago"
            android:textColor="@color/light_gray"
            tools:ignore="RtlHardcoded"
            android:paddingBottom="7dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/healthData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingTop="5dp">

            <TextView
                android:id="@+id/textExertion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:ignore="RtlHardcoded"
                android:text="- - -"
                android:layout_marginEnd="15dp"
                android:drawableStart="@drawable/exertion"
                android:drawablePadding="5dp"/>

            <TextView
                android:id="@+id/textHeartRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:ignore="RtlHardcoded"
                android:text="- - -"
                android:layout_marginEnd="15dp"
                android:drawableStart="@drawable/heart"
                android:drawablePadding="5dp"/>
            <TextView
                android:id="@+id/textCoreBodyTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginEnd="15dp"
                android:drawableStart="@drawable/corebodytemp"
                android:contentDescription="@string/skin_temperature"
                android:drawablePadding="5dp"/>

            <TextView
                android:id="@+id/textVo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/vo2"
                android:text="- - -"
                android:textSize="12sp"
                tools:ignore="RtlHardcoded"
                android:gravity="center_vertical"
                android:drawablePadding="5dp"
                android:layout_toEndOf="@id/textHrlv"/>

<!--            <TextView-->
<!--                android:id="@+id/textCoreBodyTemp"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:drawableStart="@drawable/corebodytemp"-->
<!--                android:text="- - -"-->
<!--                android:textSize="12sp"-->
<!--                android:gravity="center_vertical"-->
<!--                tools:ignore="RtlHardcoded"-->
<!--                android:drawablePadding="0dp"/>-->
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/expandedHealthData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textCaloricBurnRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:ignore="RtlHardcoded"
                android:text="- - -"
                android:layout_marginEnd="15dp"
                android:drawableStart="@drawable/calories"
                android:drawablePadding="5dp"/>

            <TextView
                android:id="@+id/textHrlv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:ignore="RtlHardcoded"
                android:text="- - -"
                android:layout_marginEnd="15dp"
                android:drawableStart="@drawable/hrlv"
                android:drawablePadding="5dp"
                android:layout_toEndOf="@id/textCaloricBurnRate"/>

<!--            <TextView-->
<!--                android:id="@+id/textVo2"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:drawableStart="@drawable/vo2"-->
<!--                android:text="- - -"-->
<!--                android:textSize="12sp"-->
<!--                tools:ignore="RtlHardcoded"-->
<!--                android:layout_marginEnd="15dp"-->
<!--                android:drawablePadding="5dp"-->
<!--                android:layout_toEndOf="@id/textHrlv"/>-->

            <TextView
                android:id="@+id/textHrv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/hrv"
                android:text="- - -"
                android:textSize="12sp"
                tools:ignore="RtlHardcoded"
                android:drawablePadding="5dp"
                android:layout_marginTop="3dp"
                android:layout_below="@id/textCaloricBurnRate"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/previousAlert"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <View
                android:layout_width="200dp"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/previous_alerts"
                android:textSize="12sp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconWearableLogo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/wearos"
            android:layout_marginEnd="7dp"
            android:layout_alignParentEnd="true"/>

        <TextView
            android:id="@+id/textBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="100%"
            tools:ignore="RtlHardcoded"
            android:layout_below="@id/iconWearableLogo"
            android:layout_alignParentEnd="true"
            android:drawableStart="@drawable/battery"
            android:drawablePadding="5dp"/>


    </RelativeLayout>
<!--    <LinearLayout-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        android:backgroundTint="@color/white"/>-->

</LinearLayout>
