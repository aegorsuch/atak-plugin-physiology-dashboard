<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    tools:ignore="UselessParent"
    android:background="@color/greenbg"
    style="@style/AppTheme">

    <ImageView
        android:id="@+id/alertIcon"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_margin="10dp"
        android:src="@drawable/danger"
        tools:ignore="ContentDescription"
        android:layout_gravity="center_vertical"
        android:visibility="invisible"/>

    <LinearLayout
        android:id="@+id/nameAndAlerts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textCallsign"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:text="Callsign"
            android:textColor="@color/white"
            tools:ignore="RtlHardcoded"/>

        <TextView
            android:id="@+id/textisFalsePositive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="Band not worn properly, readings may be incorrect"
            android:textColor="@color/light_gray"
            tools:ignore="RtlHardcoded"
            android:paddingBottom="7dp"
            android:drawableStart="@drawable/isfalsepositive"
            android:visibility = "gone"/>

        <TextView
            android:id="@+id/textLastConnected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="Last connected X minutes ago"
            android:textColor="@color/light_gray"
            tools:ignore="RtlHardcoded"
            android:paddingBottom="7dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/healthData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textHeartRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                tools:ignore="RtlHardcoded"
                android:text="- - -"
                android:layout_marginEnd="15dp"
                android:drawableStart="@drawable/heartrate"
                android:drawablePadding="5dp"/>

            <TextView
                android:id="@+id/textExertion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                tools:ignore="RtlHardcoded"
                android:text="- - -"
                android:layout_marginEnd="15dp"
                android:drawableStart="@drawable/exertion"
                android:drawablePadding="5dp"/>

            <TextView
                android:id="@+id/textCoreBodyTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/corebodytemp"
                android:text="- - -"
                android:textSize="15sp"
                tools:ignore="RtlHardcoded"
                android:drawablePadding="5dp"/>
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iconWearableLogo"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/biostrap"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>

        <TextView
            android:id="@+id/textBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="100%"
            tools:ignore="RtlHardcoded"
            android:layout_below="@id/iconWearableLogo"
            android:layout_alignParentEnd="true"
            android:drawableStart="@drawable/battery"
            android:drawablePadding="5dp"/>
    </RelativeLayout>
<!--    <LinearLayout-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        android:backgroundTint="@color/white"/>-->

</LinearLayout>
