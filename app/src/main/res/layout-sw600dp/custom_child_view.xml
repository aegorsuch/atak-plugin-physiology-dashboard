<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingStart="80dp"
    android:paddingEnd="20dp"
    android:paddingVertical="5dp">

    <TextView
        android:id="@+id/alertOrClearEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:drawablePadding="5dp"
        android:text = "oogabooga"/>

    <TextView
        android:id="@+id/alertPriority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="alert priority"
        android:layout_toEndOf="@id/alertOrClearEvent"/>

    <TextView
        android:id="@+id/alertCause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="alert cause"
        android:layout_toEndOf="@id/alertPriority"
        android:layout_marginStart="130dp"/>

    <TextView
        android:id="@+id/alertTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="alert time"
        android:layout_alignParentEnd="true"/>

</RelativeLayout>