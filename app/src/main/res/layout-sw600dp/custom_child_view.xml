<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingHorizontal="75dp"
    android:paddingVertical="5dp">

    <RelativeLayout
        android:id="@+id/expandedHealthData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/textCaloricBurnRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="- - -"
            android:layout_marginEnd="15dp"
            android:drawableStart="@drawable/calories"
            android:drawablePadding="5dp"/>

        <TextView
            android:id="@+id/textHrlv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="- - -"
            android:layout_marginEnd="15dp"
            android:drawableStart="@drawable/hrlv"
            android:drawablePadding="5dp"
            android:layout_toEndOf="@id/textCaloricBurnRate"/>

        <TextView
            android:id="@+id/textVo2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/vo2"
            android:text="- - -"
            android:textSize="15sp"
            android:layout_marginEnd="15dp"
            android:layout_toEndOf="@id/textHrlv"
            android:drawablePadding="5dp"/>

        <TextView
            android:id="@+id/textHrv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/hrv"
            android:text="- - -"
            android:textSize="15sp"
            android:drawablePadding="5dp"
            android:layout_toEndOf="@id/textVo2"/>

    </RelativeLayout>

    <TextView
        android:id="@+id/alertOrClearEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text = "oogabooga"/>

    <TextView
        android:id="@+id/alertPriority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="alert priority"
        android:layout_toEndOf="@id/alertOrClearEvent"/>

    <TextView
        android:id="@+id/alertCause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="alert cause"
        android:layout_centerInParent="true" />

    <TextView
        android:id="@+id/alertTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="alert time"
        android:layout_alignParentEnd="true"/>

</RelativeLayout>